# AI provider (OpenAI-compatible)
AI_API_KEY=sk-...
AI_API_URL=https://api.openai.com/v1/chat/completions
# For xAI/Grok:
# AI_API_URL=https://api.x.ai/v1/chat/completions

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional base URL for success redirects
NEXT_PUBLIC_BASE_URL=https://bidcheckpro-app.vercel.app

# Provisional local PostgreSQL only. Unset fails closed with HTTP 503.
# This is not approval of a hosted database. Remote hosts are refused.
# FULFILLMENT_DATABASE_URL=postgresql:///bidcheckpro_fulfillment?host=/var/run/postgresql
# FULFILLMENT_RETENTION_DAYS=

# Email sending is disabled in the application. These values are not read.
RESEND_API_KEY=re_...
RESEND_FROM=BidCheckPro <reviews@yourdomain.com>