# Public origin for Checkout success and cancel URLs.
# Required. Production must be https and must not be localhost.
# There is no localhost fallback.
NEXT_PUBLIC_BASE_URL=https://www.bidcheckpro.com

# Stripe. Use sk_test_ until the owner approves a live key.
# Never commit either value. The browser does not set prices.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PostgreSQL fulfillment ledger. Local Postgres or a hosted database such as Neon.
# Non-local hosts must use TLS (sslmode=require). Unset returns HTTP 503.
# FULFILLMENT_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/bidcheckpro?sslmode=require
# Optional. A positive integer sets retain_until on new consented bids.
# FULFILLMENT_RETENTION_DAYS=30

# Customer email is sent only by the fulfillment webhook. POST /api/send-email stays closed.
RESEND_API_KEY=re_...
RESEND_FROM=BidCheckPro <reviews@bidcheckpro.com>

# Optional. Without AI_API_KEY, /api/review uses the deterministic rule checker.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions

# Test-only. Ignored unless the host is 127.0.0.1, localhost, or ::1.
# STRIPE_MOCK_HOST=127.0.0.1
# STRIPE_MOCK_PORT=12111
# RESEND_API_BASE=http://127.0.0.1:12112
